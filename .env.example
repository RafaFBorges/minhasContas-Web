# URL da API REST. Só o servidor do Next lê esta variável (o navegador fala apenas com /api do próprio site),
# então ela não vai para o bundle e pode ser trocada sem refazer o build.
# Em desenvolvimento (npm run dev) pode ser http://localhost:8080/ (também é o padrão se faltar)
# Em produção precisa ser https:// (o build falha se não for)
API_URL=http://localhost:8080/

# Só para testar um build de produção local com a API em HTTP. Nunca no deploy
# ALLOW_INSECURE_API_URL=1
