# API REST Handler
# Em desenvolvimento (npm run dev) pode ser http://localhost:8080/
# No build de produção precisa ser https:// (o build falha se não for)
NEXT_PUBLIC_API_URL=http://localhost:8080/

# Só para testar um build de produção local com a API em HTTP. Nunca no deploy
# ALLOW_INSECURE_API_URL=1
